# Force 5 CRM BFF — copy to .env (loaded by `pnpm dev`). All values are validated at boot (src/config.ts).

# local | dev | staging | production   (local: non-Secure cookie, dev session secret allowed, no HSTS)
APP_ENV=local
PORT=8082
HOST=0.0.0.0
BASE_PATH=/crm

# VMS internal API and Keycloak. Defaults point at apps/mock-vms (port 8090).
#   dev VMS:   http://localhost:8080/vms/internal/v1/
#   prod VMS:  https://api.force5.cloud/internal/v1/
#   Keycloak:  https://keycloak.force5.cloud/realms/
VMS_URL=http://localhost:8090/vms/internal/v1/
KEYCLOAK_URL=http://localhost:8090/realms/
KEYCLOAK_REALM=gatekeeper
KEYCLOAK_CLIENT_ID=gk-admin
X_APP_ID=CRM_001

# Required (>= 32 chars) unless APP_ENV=local. Signs the session cookie and derives the key that
# encrypts the pending-login password.
SESSION_SECRET=
SESSION_IDLE_MINUTES=60
# Optional. When unset an in-memory store is used (single instance only).
REDIS_URL=

# Path to the built SPA (apps/web/dist). When set, served under BASE_PATH with index.html fallback.
WEB_DIST=

# Decision D1: who may use the CRM.
CRM_ALLOWED_TENANT_IDS=1
CRM_REQUIRED_PERMISSION=MANAGE_ACCOUNT

# Optional
SENTRY_DSN=
CDN_DEFAULT_LOGIN_BG=https://cdn.force5-dev.com/f5/assets/f5-login-bg.png
CDN_DEFAULT_LOGO=https://cdn.force5-dev.com/f5/assets/f5-logo-dark.png
# Extra img-src origins for the CSP, comma separated
CSP_IMG_ORIGINS=
# Trust X-Forwarded-* headers (default: true unless APP_ENV=local)
TRUST_PROXY=
LOG_LEVEL=info
VMS_TIMEOUT_MS=20000
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_EMAIL=10
