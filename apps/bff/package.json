{
  "name": "@crm/bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local-vms": "tsx watch --env-file=local-vms.env src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1146.0",
    "@crm/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^9.0.0",
    "@sentry/node": "^11.5.0",
    "connect-redis": "^10.0.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.6.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
