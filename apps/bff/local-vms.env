# BFF against a locally running vmsServer (./gradlew bootRun → :8080, profile `local`).
# Keycloak is the mock (apps/mock-vms in "Keycloak only" mode), which checks passwords against that VMS.
# No secrets here: APP_ENV=local allows the built-in dev session secret.
APP_ENV=local
PORT=8082
VMS_URL=http://localhost:8080/vms/internal/v1/
KEYCLOAK_URL=http://localhost:8090/realms/
CRM_ALLOWED_ROLES=CRM_ADMIN,ROLE_ADMIN
CSP_IMG_ORIGINS=http://localhost:8080
