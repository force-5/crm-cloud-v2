# Base URL of the CRM BFF (including the /crm/api prefix).
# Defaults when unset:
#   Android emulator  -> http://10.0.2.2:8082/crm/api   (10.0.2.2 = the host machine)
#   iOS simulator/web -> http://localhost:8082/crm/api
# Physical device on the same Wi-Fi: use your computer's LAN IP, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8082/crm/api
# Copy to .env.local (git-ignored) and restart `expo start --clear`.
EXPO_PUBLIC_API_URL=
